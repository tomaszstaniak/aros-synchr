.key TAG/A,PEER/A,WRONG/A
; AROS Shell script for the TLS probe; staged with the binary and run as
;   Execute RAM:stp/guest.scr <tag> <peer-id> <wrong-id>
; Results go to RESULTS:stp-<tag>-*.log under names unique to the run.
; The client identity lives in SYS:st-poc/id so that it outlives the
; extracted payload and later runs reuse it.
FailAt 1000
; The default Shell stack on AROS One (40960 bytes on fresh pool copies)
; is too small to rely on for OpenSSL.
Stack 262144
Protect RAM:stp/tlsprobe +rwed
Version >RESULTS:stp-<TAG>-0-system.txt
Version bsdsocket.library FULL >>RESULTS:stp-<TAG>-0-system.txt
If NOT EXISTS SYS:st-poc/id
  MakeDir SYS:st-poc SYS:st-poc/id
EndIf
; 1: without selecting JITTER there must be no seed source at all
RAM:stp/tlsprobe RESULTS:stp-<TAG>-1-nojitter.log no-jitter-select
Echo "1-nojitter rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
; 2: jitterentropy initialisation forced to fail: no key, no connection
MakeDir RAM:stp/failid
RAM:stp/tlsprobe RESULTS:stp-<TAG>-2-failinit.log fail-jitter-init RAM:stp/failid
Echo "2-failinit rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
List RAM:stp/failid >RESULTS:stp-<TAG>-2-failinit-dir.txt
; 3: identity: created once, then only loaded
If NOT EXISTS SYS:st-poc/id/cert.pem
  RAM:stp/tlsprobe RESULTS:stp-<TAG>-3-create.log create SYS:st-poc/id
  Echo "3-create rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
EndIf
; 3b: a new identity in RAM: on every run, so key generation is always
; exercised by the binary under test
MakeDir RAM:stp/newid
RAM:stp/tlsprobe RESULTS:stp-<TAG>-3b-create-ram.log create RAM:stp/newid
Echo "3b-create-ram rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
RAM:stp/tlsprobe RESULTS:stp-<TAG>-4-show.log show SYS:st-poc/id
Echo "4-show rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
; 5: TLS 1.3 to the peer with the expected Device ID
RAM:stp/tlsprobe RESULTS:stp-<TAG>-5-connect-ok.log connect SYS:st-poc/id 10.0.2.2 22100 <PEER> 90
Echo "5-connect-ok rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
; 6: the same peer, but a different expected Device ID: must be refused
RAM:stp/tlsprobe RESULTS:stp-<TAG>-6-connect-wrong.log connect SYS:st-poc/id 10.0.2.2 22100 <WRONG> 90
Echo "6-connect-wrong rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
; 7: identity reloaded by a new process gives the same Device ID
RAM:stp/tlsprobe RESULTS:stp-<TAG>-7-show-again.log show SYS:st-poc/id
Echo "7-show-again rc=$RC" >>RESULTS:stp-<TAG>-8-rc.txt
Echo "done" >RESULTS:stp-<TAG>-9-done.txt
