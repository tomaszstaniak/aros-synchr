# Copy to local.env and fill in. local.env is ignored by Git.
# Values given in the environment take precedence over this file.

# Target (architecture-ABI); selects build/<target> and deps/<target>.
ST_TARGET=x86_64-aros-v11

# Cross toolchain directory containing x86_64-aros-gcc, and the SDK the
# program is built against (passed as --sysroot). They must belong to the
# same AROS build as the machine the program runs on.
AROS_TC=/path/to/toolchain
AROS_SDK=/path/to/sdk

# OpenSSL release tarball (openssl-4.0.1.tar.gz). Its SHA-256 is checked
# by scripts/build-openssl.sh.
OPENSSL_TARBALL=/path/to/openssl-4.0.1.tar.gz

# jitterentropy developer package for the same target
# (JitterEntropy-3.7.0-aros*.x86_64-aros-v11.zip), the entropy source for
# AROS systems without getentropy().
JENT_PACKAGE=/path/to/JitterEntropy-3.7.0-aros1.x86_64-aros-v11.zip

# Host OpenSSL for host builds of the probe and tests.
HOST_OPENSSL=/path/to/openssl

# Unmodified Syncthing binary used for the dedicated test peer.
SYNCTHING_BIN=/path/to/syncthing

# liblz4 on the host, the reference compressor for unit tests only.
HOST_LZ4=/path/to/lz4

# Directory of the AROS test pool (vm.sh), for scripts/aros-sync-test.sh.
AROS_VM_DIR=/path/to/pool

# Limpet release archive, optional, for scripts/make-demo-stage.sh.
LIMPET_ZIP=/path/to/Limpet-0.1.0-abiv11.zip

# v1 builds its own JitterEntropy from this verified upstream release tarball.
# https://github.com/smuellerDD/jitterentropy-library/archive/refs/tags/v3.7.0.tar.gz
# Set ST_TARGET=x86_64-aros-v1 and the matching AROS_TC/AROS_SDK in the environment.
JENT_TARBALL=/path/to/jitterentropy-library-3.7.0.tar.gz

# Optional absolute private test-peer home; use with separate ST_PEER_FOLDER_DIR and ports.
# ST_PEER_HOME=/path/to/private/test-peer
