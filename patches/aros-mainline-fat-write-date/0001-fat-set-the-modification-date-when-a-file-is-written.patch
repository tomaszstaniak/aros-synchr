+#MM- test-quick : test-fat-writedate-quick
+#MM test-fat-writedate : includes linklibs
+
+%build_prog mmake=test-fat-writedate \
+	files="fatwritedate" \
+	progname=fatwritedate targetdir=$(AROS_TESTS)/filesys/fat
diff --git a/rom/filesys/fat/fat_fs.h b/rom/filesys/fat/fat_fs.h
index d8eef0ef..6321279a 100644
--- a/rom/filesys/fat/fat_fs.h
+++ b/rom/filesys/fat/fat_fs.h
@@ -122,6 +122,13 @@ struct ExtFileLock
 
     BOOL                do_notify;      /* if set, send notification on file close (ACTION_END) */
     struct FSSuper      *sb;            /* pointer to sb, for unlocking when volume is removed */
+
+    /* Kept last: a handler adopting a volume from another handler instance
+       patches the fields above in that instance's locks */
+    BOOL                date_set;       /* write_date/write_time below were stored
+                                           by a change made through this lock */
+    UWORD               write_date;     /* that modification date (FAT format) */
+    UWORD               write_time;
 };
 
 struct GlobalLock
diff --git a/rom/filesys/fat/lock.c b/rom/filesys/fat/lock.c
index 731a9b96..a675f699 100644
--- a/rom/filesys/fat/lock.c
+++ b/rom/filesys/fat/lock.c
@@ -293,6 +293,7 @@ LONG LockFile(ULONG dir_cluster, ULONG dir_entry, LONG access,
     fl->pos = 0;
 
     fl->do_notify = FALSE;
+    fl->date_set = FALSE;
 
     fl->gl = gl;
     fl->sb = glob->sb;
@@ -338,6 +339,7 @@ LONG LockRoot(LONG access, struct ExtFileLock **lock, struct Globals *glob)
     fl->pos = 0;
 
     fl->do_notify = FALSE;
+    fl->date_set = FALSE;
 
     if (IsListEmpty(&glob->sb->info->root_lock.locks))
         ADDTAIL(&glob->sb->info->locks, &glob->sb->info->root_lock);
diff --git a/rom/filesys/fat/ops.c b/rom/filesys/fat/ops.c
index ed08beba..c887333f 100644
--- a/rom/filesys/fat/ops.c
+++ b/rom/filesys/fat/ops.c
@@ -12,6 +12,7 @@
 
 #include <proto/exec.h>
 #include <proto/utility.h>
+#include <proto/dos.h>
 
 #include <aros/macros.h>
 #include <exec/types.h>
@@ -118,6 +119,47 @@ static LONG MoveToSubdir(struct DirHandle *dh, UBYTE **pname,
     return 0;
 }
 
+/* Changing a file's contents or length sets its modification date to the
+ * current time, as other AROS filesystems do. The dir entry is rewritten
+ * for this only when the date in FAT's two-second resolution differs from
+ * the one last stored through the same lock, so a run of writes costs at
+ * most one entry update per two seconds. */
+static void CurrentWriteDate(UWORD *wdate, UWORD *wtime, struct Globals *glob)
+{
+    struct DateStamp ds;
+
+    DateStamp(&ds);
+    ConvertDOSDate(&ds, wdate, wtime, glob);
+}
+
+static void SetWriteDate(struct DirEntry *de, struct Globals *glob)
+{
+    UWORD wdate, wtime;
+
+    CurrentWriteDate(&wdate, &wtime, glob);
+    de->e.entry.write_date = wdate;
+    de->e.entry.write_time = wtime;
+    de->e.entry.last_access_date = wdate;
+}
+
+/* Called once the entry filled by SetWriteDate has been written */
+static void NoteWriteDate(struct ExtFileLock *lock, struct DirEntry *de)
+{
+    lock->write_date = de->e.entry.write_date;
+    lock->write_time = de->e.entry.write_time;
+    lock->date_set = TRUE;
+}
+
+static BOOL WriteDateOutdated(struct ExtFileLock *lock, struct Globals *glob)
+{
+    UWORD wdate, wtime;
+
