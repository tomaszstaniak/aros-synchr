 .../debug/test/filesys/fat/mmakefile.src      |   8 +
 rom/filesys/fat/fat_fs.h                      |   7 +
 rom/filesys/fat/lock.c                        |   2 +
 rom/filesys/fat/ops.c                         |  64 +++
