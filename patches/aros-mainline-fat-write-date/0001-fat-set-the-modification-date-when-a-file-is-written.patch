index 7aac392a..1bb077e1 100644
--- a/developer/debug/test/filesys/fat/mmakefile.src
+++ b/developer/debug/test/filesys/fat/mmakefile.src
@@ -38,3 +38,11 @@ USER_LDFLAGS := -L$(AROS_CONTRIB_LIB)
 %build_prog mmake=test-fat-parent-rename \
 	files="parent_rename" \
 	progname=parent_rename targetdir=$(AROS_TESTS)/filesys/fat
+
